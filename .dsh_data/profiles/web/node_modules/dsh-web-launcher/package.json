{
  "name": "dsh-web-launcher",
  "version": "0.3.2",
  "description": "One-click launcher for the DeepSeek Harness Web UI: installs an app-style desktop shortcut (black-whale icon) that boots `dsh web` and auto-opens the browser, plus a web_launcher model tool (install / open / status).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icons"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanwuji1/dsh-web-launcher.git"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "launcher",
    "windows",
    "web"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

